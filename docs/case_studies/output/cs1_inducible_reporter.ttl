@prefix sbol: <http://sbols.org/v3#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://example.org/genetic-circuit/> .

<https://example.org/genetic-circuit/design/cs1_inducible_reporter>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "Conceptual design for GFP" ;
    dcterms:identifier "cs1_inducible_reporter" ;
    sbol:description "GFP = NOT(n1)" .

<https://example.org/genetic-circuit/part/sensor_Inducer>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "Inducer input sensor" ;
    dcterms:identifier "sensor_Inducer" ;
    sbol:description "Detects the environmental or molecular input Inducer." ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/sensor_Inducer> .

<https://example.org/genetic-circuit/sequence/sensor_Inducer>
    a sbol:Sequence ;
    sbol:elements "ATGCCCGGGTAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs1_inducible_reporter_sensor_Inducer>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/sensor_Inducer> ;
    sbol:displayId "cs1_inducible_reporter_sensor_Inducer" .

<https://example.org/genetic-circuit/design/cs1_inducible_reporter>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs1_inducible_reporter_sensor_Inducer> .

<https://example.org/genetic-circuit/part/promoter_Inducer>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "P_Inducer" ;
    dcterms:identifier "promoter_Inducer" ;
    sbol:description "Converts input Inducer into a regulatory signal." ;
    sbol:role <https://identifiers.org/SO:0000167> ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/promoter_Inducer> .

<https://example.org/genetic-circuit/sequence/promoter_Inducer>
    a sbol:Sequence ;
    sbol:elements "TTGACAGATACT" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs1_inducible_reporter_promoter_Inducer>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/promoter_Inducer> ;
    sbol:displayId "cs1_inducible_reporter_promoter_Inducer" .

<https://example.org/genetic-circuit/design/cs1_inducible_reporter>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs1_inducible_reporter_promoter_Inducer> .

