    sbol:elements "ATGAAACGGTAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_regulator_1_n1>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/regulator_1_n1> ;
