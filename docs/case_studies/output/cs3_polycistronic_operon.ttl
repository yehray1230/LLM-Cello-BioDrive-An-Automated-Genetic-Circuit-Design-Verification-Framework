<https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_rbs_regulator_1_n1>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/rbs_regulator_1_n1> ;
    sbol:displayId "cs3_polycistronic_operon_rbs_regulator_1_n1" .

<https://example.org/genetic-circuit/design/cs3_polycistronic_operon>
