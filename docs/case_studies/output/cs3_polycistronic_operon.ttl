@prefix sbol: <http://sbols.org/v3#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://example.org/genetic-circuit/> .

<https://example.org/genetic-circuit/design/cs3_polycistronic_operon>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "Conceptual design for Y1, Y2" ;
    dcterms:identifier "cs3_polycistronic_operon" ;
    sbol:description "Y1 = n1; Y2 = n1" .

<https://example.org/genetic-circuit/part/sensor_A>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "A input sensor" ;
    dcterms:identifier "sensor_A" ;
    sbol:description "Detects the environmental or molecular input A." ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/sensor_A> .

<https://example.org/genetic-circuit/sequence/sensor_A>
    a sbol:Sequence ;
    sbol:elements "ATGCCCCAATAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_sensor_A>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/sensor_A> ;
    sbol:displayId "cs3_polycistronic_operon_sensor_A" .

<https://example.org/genetic-circuit/design/cs3_polycistronic_operon>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_sensor_A> .

<https://example.org/genetic-circuit/part/promoter_A>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "P_A" ;
    dcterms:identifier "promoter_A" ;
    sbol:description "Converts input A into a regulatory signal." ;
    sbol:role <https://identifiers.org/SO:0000167> ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/promoter_A> .

<https://example.org/genetic-circuit/sequence/promoter_A>
    a sbol:Sequence ;
    sbol:elements "TTGACAGATACT" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_promoter_A>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/promoter_A> ;
    sbol:displayId "cs3_polycistronic_operon_promoter_A" .

<https://example.org/genetic-circuit/design/cs3_polycistronic_operon>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_promoter_A> .

<https://example.org/genetic-circuit/part/sensor_B>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "B input sensor" ;
    dcterms:identifier "sensor_B" ;
    sbol:description "Detects the environmental or molecular input B." ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/sensor_B> .

<https://example.org/genetic-circuit/sequence/sensor_B>
    a sbol:Sequence ;
    sbol:elements "ATGCCCCAATAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_sensor_B>
    a sbol:SubComponent ;
