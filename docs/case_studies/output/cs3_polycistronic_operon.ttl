<https://example.org/genetic-circuit/design/cs3_polycistronic_operon>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs3_polycistronic_operon_sensor_B> .

<https://example.org/genetic-circuit/part/promoter_B>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "P_B" ;
    dcterms:identifier "promoter_B" ;
    sbol:description "Converts input B into a regulatory signal." ;
