<https://example.org/genetic-circuit/construct/tu_gate_1>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/tu_gate_1_1_logic_promoter_1_n1> .

<https://example.org/genetic-circuit/location/tu_gate_1_2_rbs_regulator_1_n1>
