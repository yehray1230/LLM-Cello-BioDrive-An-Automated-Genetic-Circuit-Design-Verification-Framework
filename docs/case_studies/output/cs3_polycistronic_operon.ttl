    sbol:elements "TTGACAGATACTAGGAGGACAAATGAAACGGTAAGCCGCCAAAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/location/tu_gate_1_1_logic_promoter_1_n1>
    a sbol:Range ;
    sbol:start "1"^^xsd:integer ;
    sbol:end "12"^^xsd:integer ;
