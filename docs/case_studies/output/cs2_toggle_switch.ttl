@prefix sbol: <http://sbols.org/v3#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://example.org/genetic-circuit/> .

<https://example.org/genetic-circuit/design/cs2_toggle_switch>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "Conceptual design for Y1, Y2" ;
    dcterms:identifier "cs2_toggle_switch" ;
    sbol:description "Y1 = NOR(IPTG, Y2); Y2 = NOR(aTc, Y1)" .

<https://example.org/genetic-circuit/part/sensor_IPTG>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "IPTG input sensor" ;
    dcterms:identifier "sensor_IPTG" ;
    sbol:description "Detects the environmental or molecular input IPTG." ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/sensor_IPTG> .

<https://example.org/genetic-circuit/sequence/sensor_IPTG>
    a sbol:Sequence ;
    sbol:elements "ATGAAATAA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs2_toggle_switch_sensor_IPTG>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/sensor_IPTG> ;
    sbol:displayId "cs2_toggle_switch_sensor_IPTG" .

<https://example.org/genetic-circuit/design/cs2_toggle_switch>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs2_toggle_switch_sensor_IPTG> .

<https://example.org/genetic-circuit/part/promoter_IPTG>
    a sbol:Component ;
    sbol:type <https://identifiers.org/SBO:0000251> ;
    sbol:name "P_IPTG" ;
    dcterms:identifier "promoter_IPTG" ;
    sbol:description "Converts input IPTG into a regulatory signal." ;
    sbol:role <https://identifiers.org/SO:0000167> ;
    sbol:hasSequence <https://example.org/genetic-circuit/sequence/promoter_IPTG> .

<https://example.org/genetic-circuit/sequence/promoter_IPTG>
    a sbol:Sequence ;
    sbol:elements "TTGACA" ;
    sbol:encoding <https://identifiers.org/edam:format_1207> .

<https://example.org/genetic-circuit/feature/cs2_toggle_switch_promoter_IPTG>
    a sbol:SubComponent ;
    sbol:instanceOf <https://example.org/genetic-circuit/part/promoter_IPTG> ;
    sbol:displayId "cs2_toggle_switch_promoter_IPTG" .

<https://example.org/genetic-circuit/design/cs2_toggle_switch>
    sbol:hasFeature <https://example.org/genetic-circuit/feature/cs2_toggle_switch_promoter_IPTG> .

