{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/egma-feedback-trace-v1.schema.json",
  "title": "EGMA evidence feedback trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "system_id",
    "budget",
    "iterations",
    "stopped_reason"
  ],
  "properties": {
    "policy_version": {
      "const": "egma-evidence-feedback-v1"
    },
    "system_id": {
      "enum": ["S0", "S1", "S2", "S3"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_id",
        "max_repair_iterations",
        "max_candidate_evaluations",
        "max_feedback_items_per_iteration",
        "max_total_feedback_items"
      ],
      "properties": {
        "budget_id": {
          "enum": ["egma-direct-budget-v1", "egma-agent-repair-budget-v1"]
        },
        "max_repair_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_candidate_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_feedback_items_per_iteration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max_total_feedback_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "iterations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration_index",
          "candidate_id",
          "formal_success",
          "ranking_feedback",
          "repair_feedback"
        ],
        "properties": {
          "iteration_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "formal_success": {
            "type": "boolean"
          },
          "ranking_feedback": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/feedbackItem"
            }
          },
          "repair_feedback": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/feedbackItem"
            }
          }
        }
      }
    },
    "stopped_reason": {
      "enum": [
        "formal_success",
        "budget_exhausted",
        "nonrepairable",
        "invalid_intent",
        "operational_failure"
      ]
    },
    "prompt_messages": {},
    "tool_messages": {},
    "agent_state": {},
    "cache_payload": {},
    "evidence_canaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "feedbackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "feedback_id",
        "category",
        "severity",
        "evidence_ref",
        "candidate_id",
        "payload"
      ],
      "properties": {
        "policy_version": {
          "const": "egma-evidence-feedback-v1"
        },
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "output_contract_failure",
            "specification_incomplete",
            "formal_syntax_failure",
            "topology_invariant_failure",
            "truth_table_mismatch",
            "constraint_failure",
            "signal_overlap",
            "simulation_incomplete",
            "provenance_gap",
            "unsupported_claim"
          ]
        },
        "severity": {
          "enum": ["blocking", "warning"]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
